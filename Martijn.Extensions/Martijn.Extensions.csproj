<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unmodified copy of github.com/mjwsteenbergen/martijn.extensions at tag v1.15.0
    (the version ApiLibs used from NuGet). It is the Newtonsoft.Json side of the
    System.Text.Json migration and the oracle for Martijn.Extensions.JSONTest.
    Version is pinned so a packed ApiLibs keeps depending on Martijn.Extensions 1.15.0.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>enable</Nullable>
    <Version>1.15.0</Version>
    <IsPackable>false</IsPackable>
    <PackageProjectUrl>git@github.com:mjwsteenbergen/martijn.extensions</PackageProjectUrl>
    <RepositoryUrl>git@github.com:mjwsteenbergen/martijn.extensions.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>Extension methods for functionality C# does not have</Description>
    <Authors>Martijn Steenbergen</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="1.1.1" />
    <PackageReference Include="Newtonsoft.Json" Version="12.0.3" />
  </ItemGroup>

</Project>
